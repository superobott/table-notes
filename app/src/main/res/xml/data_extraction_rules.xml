<data-extraction-rules>
    <cloud-backup>
        <!-- Database-only allowlist excludes sharedpref, including the device-bound API key. -->
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Database-only allowlist excludes sharedpref, including the device-bound API key. -->
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
